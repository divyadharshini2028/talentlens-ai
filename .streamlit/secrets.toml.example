# Streamlit Community Cloud Secrets Template
#
# When deploying to Streamlit Community Cloud:
# 1. Open your app dashboard at https://share.streamlit.io/
# 2. Go to App Settings -> Secrets
# 3. Paste the following configuration and substitute your actual Gemini API key:
#
# GEMINI_API_KEY = "AIzaSy..."
#
# For local testing using Streamlit secrets instead of .env:
# Copy this file to .streamlit/secrets.toml (which is git-ignored) and add your key.

GEMINI_API_KEY = "your_gemini_api_key_here"
